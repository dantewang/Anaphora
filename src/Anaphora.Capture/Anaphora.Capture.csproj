<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows.Graphics.Capture session, D3D11 device, the GPU-side ROI atlas copy
       and the single staging readback per frame. -->
  <PropertyGroup>
    <TargetFramework>$(AnaphoraWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Anaphora.Analysis/Anaphora.Analysis.csproj" />
    <ProjectReference Include="../Anaphora.Core/Anaphora.Core.csproj" />
  </ItemGroup>

</Project>
