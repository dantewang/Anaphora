<Project Sdk="Microsoft.NET.Sdk">

  <!-- Entry point plus the configuration UI: pick the game window, draw ROIs on a
       captured still, tune thresholds, watch live readings, manage profiles. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(AnaphoraWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Unconditional on purpose: BuildAvaloniaApp() calls .WithDeveloperTools()
         outside any #if, only the AttachDeveloperTools() call is Debug-gated. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Anaphora.Analysis/Anaphora.Analysis.csproj" />
    <ProjectReference Include="../Anaphora.Capture/Anaphora.Capture.csproj" />
    <ProjectReference Include="../Anaphora.Core/Anaphora.Core.csproj" />
    <ProjectReference Include="../Anaphora.Overlay/Anaphora.Overlay.csproj" />
  </ItemGroup>

</Project>
