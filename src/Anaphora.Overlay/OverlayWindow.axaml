<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Anaphora.Overlay"
        x:Class="Anaphora.Overlay.OverlayWindow"
        x:DataType="local:OverlayViewModel"
        Title="Anaphora Overlay"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        Focusable="False">

  <!-- Sized for a 1920-DIP-wide game at 100%; OverlayWindow scales the whole tree
       so it keeps the same share of the screen at any resolution.

       Two things only. The key to press is Endfield's white title card, the one
       the game throws up on a new area or a boss; under it, the current segment
       of the rotation as a row of discs, with the cursor on the one to press.

       The card's ratios come from the generator the community built from the
       game's own assets (endfieldtext.ccomm.top, GPLv3), at the 大 setting:
       cap height .095 of the screen (the game's own is .2472), so on 1080 that
       is 102 DIP and, with Arial Black's .7158 cap, FontSize 143. Letter
       spacing is .021875 / .2472 of cap, times .35 for Latin.

       The game dims the whole screen behind its card; an overlay cannot, so the
       white is ringed in near-black instead (OutlinedText). Everything is a font
       Windows already ships: Arial Black for the key, Microsoft YaHei UI for
       the Chinese. -->
  <Window.Resources>
    <SolidColorBrush x:Key="Ground" Color="#B20A0B0B" />
    <SolidColorBrush x:Key="Ink" Color="#F00A0B0B" />
    <SolidColorBrush x:Key="Hairline" Color="#26ECEBE6" />
    <SolidColorBrush x:Key="Text" Color="#ECEBE6" />
    <SolidColorBrush x:Key="Muted" Color="#8A8E8F" />
    <SolidColorBrush x:Key="Amber" Color="#F0B429" />
    <SolidColorBrush x:Key="Ready" Color="#F6F6F3" />
    <SolidColorBrush x:Key="Warn" Color="#E5484D" />
    <SolidColorBrush x:Key="Lime" Color="#B8D433" />
    <FontFamily x:Key="Body">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
    <FontFamily x:Key="Title">Arial Black, Segoe UI Black, Microsoft YaHei UI</FontFamily>

    <!-- the cues above the card: bigger than the ones in the strip -->
    <DataTemplate x:Key="CueChip" x:DataType="local:StepChip">
      <local:ShapeDecorator Classes="cue">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="3">
          <TextBlock Classes="badge" Text="{Binding Badge}" IsVisible="{Binding HasBadge}" />
          <TextBlock Classes="main" Text="{Binding Main}" />
        </StackPanel>
      </local:ShapeDecorator>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
    </Style>

    <!-- the title card -->
    <Style Selector="local|OutlinedText.key">
      <Setter Property="FontFamily" Value="{StaticResource Title}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="143" />
      <Setter Property="Fill" Value="White" />
      <Setter Property="Stroke" Value="{StaticResource Ink}" />
      <Setter Property="StrokeThickness" Value="11" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="local|OutlinedText.key.blocked">
      <Setter Property="Fill" Value="#C9C2BB" />
    </Style>
    <Style Selector="local|OutlinedText.second">
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="43" />
      <Setter Property="LetterSpacing" Value="6" />
      <Setter Property="Fill" Value="White" />
      <Setter Property="Stroke" Value="{StaticResource Ink}" />
      <!-- the ring stays the same share of the glyph as the key's 11/143 -->
      <Setter Property="StrokeThickness" Value="3.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="3,10,0,0" />
    </Style>
    <Style Selector="local|OutlinedText.second.blocked">
      <Setter Property="Fill" Value="{StaticResource Warn}" />
    </Style>
    <Style Selector="local|OutlinedText.sub">
      <Setter Property="FontFamily" Value="{StaticResource Title}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="LetterSpacing" Value="8" />
      <Setter Property="Fill" Value="White" />
      <Setter Property="Stroke" Value="{StaticResource Ink}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,8,0,0" />
    </Style>

    <!-- soft cues: dashed lime, because nothing on screen confirms them -->
    <Style Selector="local|ShapeDecorator.cue">
      <Setter Property="Slant" Value="6" />
      <Setter Property="Height" Value="29" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Dashed" Value="True" />
      <Setter Property="Fill" Value="#590A0B0B" />
      <Setter Property="Stroke" Value="{StaticResource Lime}" />
    </Style>
    <Style Selector="local|ShapeDecorator.cue TextBlock.main">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource Lime}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="local|ShapeDecorator.cue TextBlock.badge">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="Foreground" Value="#B8B8D433" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <!-- the rotation strip: one disc per step, the way the game draws a skill -->
    <Style Selector="StackPanel.cell">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="StackPanel.cell.done">
      <Setter Property="Opacity" Value="0.24" />
    </Style>
    <Style Selector="StackPanel.cell.now">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Ellipse.disc">
      <Setter Property="Fill" Value="#D11B1D1D" />
      <Setter Property="Stroke" Value="#3DECEBE6" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="Ellipse.disc.now">
      <Setter Property="Fill" Value="#E0241C08" />
      <Setter Property="Stroke" Value="{StaticResource Amber}" />
      <Setter Property="StrokeThickness" Value="3" />
    </Style>
    <Style Selector="Ellipse.disc.held">
      <Setter Property="Stroke" Value="{StaticResource Warn}" />
    </Style>
    <Style Selector="TextBlock.glyph">
      <Setter Property="FontFamily" Value="{StaticResource Title}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="29" />
      <Setter Property="Foreground" Value="#D6ECEBE6" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.cell.now TextBlock.glyph">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <!-- what the key alone does not say: the slot a chain fires, or 长按 -->
    <Style Selector="Border.tag">
      <Setter Property="Background" Value="{StaticResource Ready}" />
      <Setter Property="Padding" Value="3,0" />
      <Setter Property="MinWidth" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="Border.tag.hold">
      <Setter Property="Background" Value="{StaticResource Amber}" />
    </Style>
    <Style Selector="Border.tag TextBlock">
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#111111" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="local|ShapeDecorator.precue">
      <Setter Property="Slant" Value="4" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Dashed" Value="True" />
      <Setter Property="Fill" Value="#590A0B0B" />
      <Setter Property="Stroke" Value="#CCB8D433" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="local|ShapeDecorator.precue TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Lime}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.body">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="StackPanel.body.stale">
      <Setter Property="Opacity" Value="0.38" />
    </Style>
  </Window.Styles>

  <LayoutTransformControl x:Name="Scaler">
    <Panel Margin="0,0,0,24">
      <StackPanel Classes="body" Classes.stale="{Binding !Live}" Spacing="9" HorizontalAlignment="Center">

        <StackPanel HorizontalAlignment="Center">
          <ItemsControl ItemsSource="{Binding NowCues}" ItemTemplate="{StaticResource CueChip}"
                        IsVisible="{Binding HasCues}" HorizontalAlignment="Center" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <local:OutlinedText Classes="key" Classes.blocked="{Binding NowAction.Blocked}"
                              Text="{Binding NowAction.Glyph}" />
          <local:OutlinedText Classes="second" Classes.blocked="{Binding NowAction.Blocked}"
                              Text="{Binding NowAction.Second}" IsVisible="{Binding NowAction.HasSecond}" />
          <!-- The game's Sarkaz sub-script trails off to the right. Five Latin
               letters doing the same just read as a rendering fault, so this one
               does not fade. -->
          <local:OutlinedText Classes="sub" Text="{Binding NowAction.Sub}" />
        </StackPanel>

        <!-- the current segment, cursor on the step to press. How long it is, is
             the user's editing decision, so nothing here truncates it; a segment
             too long to read is a segment that wants splitting. -->
        <Panel HorizontalAlignment="Center" IsVisible="{Binding TrackVisible}">
          <Border Background="{StaticResource Ground}" BorderBrush="{StaticResource Hairline}"
                  BorderThickness="1" Padding="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ItemsControl ItemsSource="{Binding Track}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:TrackCell">
                    <StackPanel Classes="cell" Classes.now="{Binding IsNow}" Classes.done="{Binding IsDone}"
                                Orientation="Horizontal" Spacing="2">
                      <!-- the cues ride in the row, before the disc they lead into:
                           no reserved band above the discs for the steps without one -->
                      <ItemsControl ItemsSource="{Binding Cues}" IsVisible="{Binding HasCues}"
                                    VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:StepChip">
                            <local:ShapeDecorator Classes="precue">
                              <TextBlock Text="{Binding Main}" />
                            </local:ShapeDecorator>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Panel Width="46" Height="46">
                        <Ellipse Classes="disc" Classes.now="{Binding IsNow}" Classes.held="{Binding Blocked}" />
                        <TextBlock Classes="glyph" Text="{Binding Glyph}" />
                        <Border Classes="tag" Classes.hold="{Binding IsHold}" IsVisible="{Binding HasBadge}">
                          <TextBlock Text="{Binding Badge}" />
                        </Border>
                      </Panel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{Binding Hint}" IsVisible="{Binding HasHint}" VerticalAlignment="Center"
                         MaxWidth="150" TextWrapping="Wrap" Margin="2,0,4,0"
                         FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Warn}" />
            </StackPanel>
          </Border>

          <!-- amber tick on the corner, the way the game marks a panel -->
          <Border Width="27" Height="2" Background="{StaticResource Amber}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />
        </Panel>
      </StackPanel>

      <Border IsVisible="{Binding !Live}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
              Margin="0,0,0,-22" Padding="7,4" Background="#CC0A0B0B"
              BorderBrush="{StaticResource Warn}" BorderThickness="2,0,0,0">
        <TextBlock Text="{Binding StaleText}" FontSize="9" FontWeight="SemiBold"
                   Foreground="{StaticResource Warn}" />
      </Border>
    </Panel>
  </LayoutTransformControl>
</Window>
