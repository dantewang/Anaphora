<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway-grade validation tool, kept in the tree because it answers the one
       question the whole project rests on: does WGC actually see the game's frames?
       Run it again whenever the game updates or the machine changes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(AnaphoraWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RootNamespace>Anaphora.CaptureProbe</RootNamespace>
  </PropertyGroup>

  <!-- Kestrel for the serve verb. A shared framework, not a package: no version to
       pin, and unlike HttpListener it binds non-loopback without a URL ACL. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The hud verb drives the production pipeline; everything else here keeps its
       own hand-rolled capture path so a regression in one cannot hide in the other. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Anaphora.Capture/Anaphora.Capture.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../profiles/*.json" Link="profiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

</Project>
