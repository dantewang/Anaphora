<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway-grade validation tool, kept in the tree because it answers the one
       question the whole project rests on: does WGC actually see the game's frames?
       Run it again whenever the game updates or the machine changes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(AnaphoraWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RootNamespace>Anaphora.CaptureProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

</Project>
