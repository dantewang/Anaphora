<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(AnaphoraTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Anaphora.Core/Anaphora.Core.csproj" />
  </ItemGroup>

  <!-- The shipped profile is a test fixture as much as it is data: if it stops
       loading or validating, the marking UI and the readers are both broken. -->
  <ItemGroup>
    <None Include="../../profiles/endfield.json" Link="profiles/endfield.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../rotations/*.json" Link="rotations/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
