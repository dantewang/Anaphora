<Project Sdk="Microsoft.NET.Sdk">

  <!-- The editor's document model: pure logic, but it lives in the app. -->
  <PropertyGroup>
    <TargetFramework>$(AnaphoraWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Anaphora.App/Anaphora.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../rotations/*.json" Link="rotations/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
