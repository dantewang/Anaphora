<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(AnaphoraTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Anaphora.Analysis/Anaphora.Analysis.csproj" />
  </ItemGroup>

  <!-- The readers have to be judged against real pixels, which means decoding
       PNG. Linking the probe's decoder rather than copying it keeps one
       implementation; it is plain BCL code with no Windows dependency. -->
  <ItemGroup>
    <Compile Include="../../tools/Anaphora.CaptureProbe/Png.cs" Link="Png.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../profiles/endfield.json" Link="profiles/endfield.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../rotations/*.json" Link="rotations/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
